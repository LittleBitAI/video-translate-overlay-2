import json
import re
import subprocess
import sys
import time

adb="<USER_HOME>/AppData/Local/Temp/vto-android/sdk/platform-tools/adb.exe"
def run(*args,data=None):
    result=subprocess.run([adb,"-s","<APPROVED_DEVICE>",*args],input=data,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=10)
    assert result.returncode==0,"Phone observer failed"
    return result.stdout.decode()
paths=run("exec-out","run-as","dev.vto.overlay","find","sync","-maxdepth","2","-name","sync.sqlite3").splitlines()
assert len(paths)==1 and re.fullmatch(r"sync/[0-9a-f]{64}/sync.sqlite3",paths[0]),"Phone observer requires the selected one-account fixture scope"
def lit(value): return "'"+value.replace("'","''")+"'"
if sys.argv[1]=="playlist":
    ident,name=sys.argv[2:]
    assert re.fullmatch(r"[a-zA-Z0-9_-]{1,64}",ident) and name.startswith("LAN ") and len(name)<=200
    sql=f"SELECT EXISTS(SELECT 1 FROM playlist WHERE id={lit(ident)} AND name={lit(name)});"
elif sys.argv[1] in ("deleted","saved"):
    key=sys.argv[2];assert re.fullmatch(r"[0-9a-f]{64}",key)
    q=lit(key)
    if sys.argv[1]=="deleted":
        sql=f"SELECT NOT EXISTS(SELECT 1 FROM video WHERE video_key={q}) AND NOT EXISTS(SELECT 1 FROM job WHERE video_key={q}) AND NOT EXISTS(SELECT 1 FROM cue WHERE video_key={q}) AND NOT EXISTS(SELECT 1 FROM playlist_entry WHERE video_key={q}) AND EXISTS(SELECT 1 FROM deleted_video WHERE video_key={q} AND complete=1);"
    else:
        sql=f"SELECT EXISTS(SELECT 1 FROM video WHERE video_key={q}) AND EXISTS(SELECT 1 FROM job WHERE video_key={q} AND stage='ready') AND EXISTS(SELECT 1 FROM cue WHERE video_key={q}) AND NOT EXISTS(SELECT 1 FROM deleted_video WHERE video_key={q});"
else: raise ValueError("Unsupported fixture observation")
rows=run("shell","-T","run-as","dev.vto.overlay","files/vto-sync-fixture",paths[0],data=sql.encode()).splitlines()
assert len(rows)==2 and rows[-1]=="fixture transaction complete" and rows[0] in ("0","1"),"Invalid fixture observation"
print(json.dumps({"matches":rows[0]=="1","observed_ms":int(time.time()*1000)}))
