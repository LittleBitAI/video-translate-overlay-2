import {chromium} from 'playwright';
import {readFile,writeFile} from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {execFile} from 'node:child_process';
import {promisify} from 'node:util';
import assert from 'node:assert/strict';
const run=promisify(execFile),adb='<USER_HOME>/AppData/Local/Temp/vto-android/sdk/platform-tools/adb.exe';
const baseline=JSON.parse(await readFile(new URL('./account-session-baseline.json',import.meta.url)));
const mismatch=JSON.parse(await readFile(new URL('./account-mismatch.json',import.meta.url)));
const digest=email=>createHash('sha256').update(baseline.salt+'\0'+email).digest('hex');
const browsers=[];let watching=true;
try{
  const pc=await chromium.connectOverCDP('http://127.0.0.1:9226');browsers.push(pc);
  const pp=pc.contexts().flatMap(c=>c.pages()).find(p=>p.url().startsWith('http://tauri.localhost'));assert(pp);
  const second=await pp.evaluate(()=>window.__TAURI_INTERNALS__.invoke('get_google_account'));assert.equal(second.state,'signed_in');
  const secondDigest=digest(second.email);assert.notEqual(secondDigest,baseline.account1_digest);
  await writeFile(new URL('./account-two-session.json',import.meta.url),JSON.stringify({account2_digest:secondDigest},null,2)+'\n',{flag:'wx'});
  const b=await chromium.connectOverCDP('http://127.0.0.1:9227');browsers.push(b);
  const p=b.contexts().flatMap(c=>c.pages()).find(p=>p.url().startsWith('http://tauri.localhost'));assert(p);
  const call=(name,args)=>p.evaluate(({name,args})=>window.__TAURI_INTERNALS__.invoke(name,args),{name,args});
  const first=await call('get_google_account');assert.equal(first.state,'signed_in');assert.equal(digest(first.email),baseline.account1_digest);
  const states=[];let final;
  const watch=(async()=>{
    const deadline=Date.now()+180000;
    while(watching&&Date.now()<deadline){
      const a=await call('get_google_account');
      const observation={state:a.state,generation:a.generation,connection:a.connection?.state??null};
      if(JSON.stringify(states.at(-1))!==JSON.stringify(observation))states.push(observation);
      if(a.generation>=first.generation+2&&a.state==='signed_in'){final=a;return;}
      if(a.generation>=first.generation+2&&!['signing_in','loading'].includes(a.state)){final=a;return;}
      await p.waitForTimeout(500);
    }
  })();
  if(!(await p.locator('section[aria-label="Google 앱 계정"]').count()))await p.getByRole('link',{name:'설정',exact:true}).click();
  await p.getByRole('button',{name:'Google 계정 로그아웃',exact:true}).click();
  await p.getByRole('button',{name:'Google 로그아웃 확인',exact:true}).click();
  await p.getByRole('button',{name:'Google 계정으로 로그인',exact:true}).waitFor();
  assert.equal((await call('get_google_account')).state,'signed_out');
  const deadline=Date.now()+10000;let services;
  do{
    services=(await run(adb,['-s','<APPROVED_DEVICE>','shell','dumpsys','activity','services','dev.vto.overlay'],{timeout:15000})).stdout;
    if(!services.includes('dev.vto.overlay/.SyncService'))break;
    await p.waitForTimeout(250);
  }while(Date.now()<deadline);
  assert(!services.includes('dev.vto.overlay/.SyncService'),'Sign-out retained Android sync service');
  const stale=await p.evaluate(async generation=>{try{await window.__TAURI_INTERNALS__.invoke('get_library',{account_generation:generation});return false;}catch(e){return e.status===409&&e.error==='account_changed';}},first.generation);assert(stale);
  await p.getByRole('button',{name:'Google 계정으로 로그인',exact:true}).click();
  console.log(JSON.stringify({phase:'phone_google_account_picker_opened',sign_out_stopped_service:true,retired_account_read_refused:true}));
  await watch;
  const result={head:baseline.head,sign_out_stopped_service:true,retired_account_read_refused:true,observations:states,state:final?.state??'awaiting_user',generation:final?.generation??null};
  if(final?.state==='signed_in'){
    result.matches_windows_second_account=digest(final.email)===secondDigest;
    if(result.matches_windows_second_account){
      let library;const deadline=Date.now()+25000;
      do{library=await call('get_library',{account_generation:final.generation});if(library.playlists.some(p=>p.id===mismatch.account_two_marker))break;await p.waitForTimeout(250);}while(Date.now()<deadline);
      assert.equal(library.videos.length,0);assert.equal(library.playlists.length,1);
      assert.equal(library.playlists[0].id,mismatch.account_two_marker);assert.equal(library.playlists[0].name,mismatch.account_two_marker_name);
      result.account_two_marker_received=true;result.first_account_rows_absent=true;
    }
  }
  await writeFile(new URL('./account-two-phone.json',import.meta.url),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result));
}finally{watching=false;for(const b of browsers)await b.close();}
