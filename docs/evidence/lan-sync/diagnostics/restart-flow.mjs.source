import {chromium} from 'playwright';
import {readFile,writeFile} from 'node:fs/promises';
import assert from 'node:assert/strict';
const port=Number(process.argv[2]),device=port===9226?'windows':'android';assert([9226,9227].includes(port));
const expected=JSON.parse(await readFile(new URL('./expected-android.json',import.meta.url)));
const prepared=JSON.parse(await readFile(new URL('./offline-prepared.json',import.meta.url)));
const browser=await chromium.connectOverCDP(`http://127.0.0.1:${port}`);
try{
  const page=browser.contexts().flatMap(c=>c.pages()).find(p=>p.url().startsWith('http://tauri.localhost'));assert(page);
  await page.waitForFunction(()=>window.__TAURI_INTERNALS__?.invoke);
  let account;
  const deadline=Date.now()+20000;
  do{account=await page.evaluate(()=>window.__TAURI_INTERNALS__.invoke('get_google_account'));if(account.state==='signed_in')break;await page.waitForTimeout(200);}while(Date.now()<deadline);
  assert.equal(account.state,'signed_in');const owner=account.generation;
  let library;
  do{
    library=await page.evaluate(g=>window.__TAURI_INTERNALS__.invoke('get_library',{account_generation:g}),owner);
    assert.equal(library.account_generation,owner);
    if(library.playlists.find(p=>p.id===prepared.playlist_id)?.name===prepared.queued_name&&!library.videos.some(v=>v.video_key===prepared.deleted_fixture))break;
    await page.waitForTimeout(200);
  }while(Date.now()<deadline);
  assert.equal(library.playlists.find(p=>p.id===prepared.playlist_id)?.name,prepared.queued_name);
  assert(!library.videos.some(v=>v.video_key===prepared.deleted_fixture));
  assert.equal(library.playlists.length,2);assert(library.playlists.every(p=>!p.entries.includes(prepared.deleted_fixture)));
  const saved=await page.evaluate(async({generation,fixture})=>({
    job:await window.__TAURI_INTERNALS__.invoke('get_job',{page_url:fixture.video.page_url,account_generation:generation}),
    subtitles:await window.__TAURI_INTERNALS__.invoke('get_subtitles',{video_key:fixture.video.key,account_generation:generation})
  }),{generation:owner,fixture:expected});
  assert.equal(saved.job.stage,'ready');assert.equal(saved.job.cost_krw,18.5);
  assert.deepEqual(saved.subtitles.cues.map(c=>[c.start_ms,c.end_ms,c.text_ko]),expected.cues.map(c=>[c.start_ms,c.end_ms,c.text_ko]));
  const receipt={device,head:await page.evaluate(()=>window.__WIKI_NATIVE_BUILD_HEAD__),state:account.state,generation:owner,restored_without_interactive_sign_in:true,queued_rename_retained:true,deletion_retained:true,two_playlists_preserved:true,unrelated_cost_krw:saved.job.cost_krw,unrelated_intervals:saved.subtitles.cues.map(c=>[c.start_ms,c.end_ms])};
  await writeFile(new URL(`./${device}-restart.json`,import.meta.url),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));
}finally{await browser.close();}
